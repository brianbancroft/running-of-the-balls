{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "running-of-the-balls",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  // Resend's SDK uses Node-style APIs. nodejs_compat is the supported Workers flag for that.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Static UI and the API ship in one Worker. /api/* runs the Worker first.
  // HTML, CSS, and the compiled client are Workers static assets.
  // purchase.html, selections.html, and admin.html are also served at
  // /purchase, /selections, and /admin.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DEMO_MODE": "true",
    "EMAIL_DELIVERY": "dry_run",
    "PAYMENT_MODE": "stripe_test_fake",
    "EMAIL_FROM": "Running of the Balls Demo <onboarding@resend.dev>",
    "PUBLIC_APP_NAME": "Ladysmith Kinsmen Running of the Balls",
    // Open product decisions. The owner has not confirmed these. Safe demo
    // defaults only. The pages say they are pending a decision. The confirmed
    // catalogue is 2,500 balls in D1. That count is not a var.
    //
    // BALL_NUMBERING: sequential_from_1 is the only scheme implemented. It
    // matches the seeded numbers 1 through 2500 and does not renumber them.
    // Any other value refuses to start.
    // BALL_NUMBER_PAD: zero-padding on the public label. 3 shows 7 as 007.
    // 0 shows 7. A longer number is not cut, so 2500 stays 2500.
    // DEMO_AMOUNT_CENTS: placeholder price for one ball, in Canadian cents.
    // 500 is $5.00 and is not a ticket price.
    // BALL_BUNDLES: JSON list. [] means no bundles. An entry is
    // {"quantity":5,"label":"Five balls"} and costs that many times
    // DEMO_AMOUNT_CENTS. A bundle cannot carry its own price.
    // ALLOW_BALL_PICKING: when a buyer may choose a ball. "true" lets them
    // pick any open ball for the whole demo. "false" assigns an open ball and
    // refuses a chosen number, including a reservation hold. There is no sale
    // window. The club has not decided which to use.
    "BALL_NUMBERING": "sequential_from_1",
    "BALL_NUMBER_PAD": "3",
    "DEMO_AMOUNT_CENTS": "500",
    "BALL_BUNDLES": "[]",
    "ALLOW_BALL_PICKING": "true",
    // Plain vars, not secrets. Leave the licence number empty until the club
    // has one. An empty number shows the unlicensed demo banner. An empty
    // rules URL points at the placeholder /rules page. Do not invent either.
    "GAMING_LICENCE_NUMBER": "",
    "GAMING_RULES_URL": ""
  },
  // Names only. Values come from .dev.vars locally or `wrangler secret put`
  // on a real Worker. Missing values warn in local dev and must not be invented here.
  // ADMIN_EMAILS is a comma-separated list. GOOGLE_* and SESSION_SECRET turn on
  // Google sign-in. Leave them empty and the Worker keeps the admin-token path.
  // Frees reservation holds whose five minutes have passed, even if that
  // browser is closed and nobody else is loading the pit. API requests also
  // sweep, so a visitor does not wait for the next minute.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY",
      "STRIPE_SECRET_KEY",
      "ADMIN_TOKEN",
      "ADMIN_EMAILS",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SESSION_SECRET"
    ]
  },
  // Hosted D1 database for the running-of-the-balls Worker.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "running-of-the-balls",
      "database_id": "be94389e-913a-49fe-804c-c2422e743a3a",
      "migrations_dir": "migrations"
    }
  ]
}
